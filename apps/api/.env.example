PORT=3333
HOST=0.0.0.0
DATABASE_URL=postgres://app_user:app_user@localhost:5433/alocidadao
CORS_ORIGIN=http://localhost:5173
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://10.0.2.2:9000
S3_REGION=us-east-1
S3_BUCKET=alocidadao-dev
S3_ACCESS_KEY_ID=alocidadao
S3_SECRET_ACCESS_KEY=alocidadao-dev
# Assina os tokens de sessão e os códigos (mínimo de 32 caracteres). Este valor é só de
# desenvolvimento: em produção, gere outro (ex.: openssl rand -base64 48).
AUTH_SECRET=dev-only-alocidadao-auth-secret-troque-em-producao
# Código fixo aceito no login, para testar sem SMS. Proibido em produção.
AUTH_DEV_FIXED_CODE=123456
# E-mail: sem RESEND_API_KEY o e-mail sai no log da API (obrigatória em produção).
# RESEND_API_KEY=
# EMAIL_FROM=Alô Cidadão <nao-responda@alocidadao.com.br>
# Push: as variáveis vão juntas. FCM: as duas; APNs: as três. Meio conjunto não sobe.
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_FILE=./secrets/firebase-service-account.json
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_KEY_FILE=./secrets/apns.p8
APNS_PRODUCTION=false

# Liga as rotas /dev/* (só desenvolvimento local). NUNCA vai para produção.
ENABLE_DEV_ROUTES=true
