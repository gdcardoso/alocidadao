# Emulador Android acessa o Mac por 10.0.2.2; em aparelho físico use o IP do Mac na rede local
EXPO_PUBLIC_API_URL=http://10.0.2.2:3333
# Ids impressos por `pnpm db:seed:dev` (identidade de dev, até existir login)
EXPO_PUBLIC_DEV_USER_ID=
EXPO_PUBLIC_DEV_TENANT_ID=

# Push (Firebase) - só Android por enquanto; nada disto vai para o git
# 1. No console do Firebase, projeto "alocidadao": adicione o app Android br.com.alocidadao.app
# 2. Baixe o google-services.json para apps/mobile/ (ou aponte outro caminho em GOOGLE_SERVICES_JSON)
# 3. Gere a conta de serviço em apps/api/secrets/firebase-service-account.json (ver apps/api/.env.example)
# 4. Rode `npx expo run:android` de novo: o arquivo só entra no build nativo ao gerar o projeto
# Sem o google-services.json o app compila, mas a tela Notificações avisa que o push não está configurado.
# GOOGLE_SERVICES_JSON=./google-services.json
