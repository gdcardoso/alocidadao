{
  "expo": {
    "name": "Alô Cidadão",
    "slug": "alocidadao",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icone-app.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.alocidadao.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icone-adaptativo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.alocidadao.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "alocidadao",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Para registrar a foto do problema.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Para saber onde está o problema e qual prefeitura atende.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      "expo-sqlite"
    ]
  }
}
