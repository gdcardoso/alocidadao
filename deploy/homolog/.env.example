# Modelo do /srv/alocidadao/.env da homologação. O .env real fica SÓ no servidor (chmod 600),
# nunca no git. Gere cada senha nova; nada dos valores de desenvolvimento.
# Formato: CHAVE=valor, sem aspas e sem espaços em volta do "=".

# --- Imagens ---------------------------------------------------------------------------------
# Onde estão as imagens alocidadao-{api,web,site,db}:<sha>.
IMAGE_REGISTRY=ghcr.io/gdcardoso

# --- Proxy (Caddy) ---------------------------------------------------------------------------
# E-mail de contato do Let's Encrypt (avisos de certificado).
ACME_EMAIL=<seu-email>

# --- Banco -----------------------------------------------------------------------------------
# Dono do banco (migrações, backups). Use só letras e números: a senha entra numa URL.
# Gere com: openssl rand -hex 32
POSTGRES_USER=alocidadao
POSTGRES_DB=alocidadao
POSTGRES_PASSWORD=<openssl rand -hex 32>
# Senha do papel app_user (o que a API usa, sujeito ao RLS). O deploy.sh aplica a cada publicação.
APP_DB_PASSWORD=<openssl rand -hex 32>

# --- API -------------------------------------------------------------------------------------
# Assina os tokens de sessão e os códigos (mínimo de 32 caracteres).
# Gere com: openssl rand -base64 48
AUTH_SECRET=<openssl rand -base64 48>
# Código fixo de 6 dígitos do app pelo celular (entrada, troca de número e recuperação de conta).
# Não vale no painel nem no backoffice. Combine o valor com a equipe por fora do git.
AUTH_APP_FIXED_CODE=<6 dígitos>
# Chave do Resend (envia o código de entrada do painel por e-mail). Obrigatória.
RESEND_API_KEY=<re_...>
EMAIL_FROM=Alô Cidadão <nao-responda@alocidadao.com.br>
PANEL_URL=https://homolog.alocidadao.com.br
AGENT_APP_PLAY_URL=https://homolog.alocidadao.com.br/app/alocidadao-homolog.apk

# Fotos no Spaces (bucket privado da homologação).
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_PUBLIC_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_REGION=us-east-1
S3_BUCKET=<bucket-das-fotos>
S3_ACCESS_KEY_ID=<chave de acesso do Spaces>
S3_SECRET_ACCESS_KEY=<segredo do Spaces>

# --- Backups do banco (backup.sh / restore.sh) -----------------------------------------------
# Pode ser o mesmo bucket das fotos com outra chave, ou um bucket só de backups.
BACKUP_S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=<bucket-dos-backups>
# Prefixo opcional dentro do bucket (sem barra no fim, ex.: db). Vazio: raiz do bucket.
BACKUP_S3_PREFIX=
BACKUP_S3_ACCESS_KEY_ID=<chave de acesso do Spaces>
BACKUP_S3_SECRET_ACCESS_KEY=<segredo do Spaces>
