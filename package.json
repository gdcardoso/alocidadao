{
  "name": "alocidadao",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "db:up": "docker compose up -d --wait db",
    "infra:up": "docker compose up -d --wait db storage && docker compose run --rm storage-init",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @alocidadao/db db:migrate",
    "db:seed:dev": "pnpm --filter @alocidadao/db db:seed:dev",
    "db:import:municipalities": "pnpm --filter @alocidadao/db db:import:municipalities",
    "db:generate": "pnpm --filter @alocidadao/db db:generate",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  }
}
